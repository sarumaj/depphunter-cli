{
  "order": ["map", "intro", "hunt", "fire", "photo", "grapple", "night"],
  "scenes": {
    "map": [
      { "do": "caption", "text": "depphunter", "sub": "Your repository as a map: one command, one binary, fully offline" },
      { "do": "hold", "s": 1 },
      { "do": "glide", "to": [0.55, 0.45], "s": 1.2 },
      { "do": "hold", "s": 0.6 },
      { "do": "glide", "to": [0.48, 0.58], "s": 1.0 },
      { "do": "click", "target": "#rotate-right" },
      { "do": "hold", "s": 1.0 },
      { "do": "click", "target": "#rotate-left", "s": 0.4 },
      { "do": "hold", "s": 0.5 },
      { "do": "caption", "text": "Select anything", "sub": "arcs to what it depends on and what depends on it, details in the panel" },
      { "do": "click", "target": "#search" },
      { "do": "type", "text": "scan.go" },
      { "do": "hold", "s": 0.6 },
      { "do": "click", "target": "#search-results li" },
      { "do": "set", "target": "#search", "value": "" },
      { "do": "hold", "s": 3.2 },
      { "do": "click", "target": "#panel-close", "s": 0.8 },
      { "do": "caption", "text": "Color it by git history", "sub": "commits, churn, age or authors" },
      { "do": "pick", "target": "#color-by", "value": "commits" },
      { "do": "glide", "to": [0.6, 0.5], "s": 0.8 },
      { "do": "hold", "s": 2.2 },
      { "do": "choose", "target": "#color-by", "value": "language" },
      { "do": "caption", "text": "Dress it as a city, a circuit board or a galaxy" },
      { "do": "pick", "target": "#style", "value": "circuit" },
      { "do": "glide", "to": [0.62, 0.5], "s": 0.6 },
      { "do": "hold", "s": 1.8 },
      { "do": "pick", "target": "#style", "value": "galaxy", "s": 0.6 },
      { "do": "glide", "to": [0.62, 0.5], "s": 0.6 },
      { "do": "hold", "s": 1.8 },
      { "do": "pick", "target": "#style", "value": "city", "s": 0.6 },
      { "do": "hold", "s": 0.4 }
    ],
    "intro": [
      { "do": "caption", "text": "Now step inside", "sub": "the same map, in first person" },
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "hold", "s": 1.2 }
    ],
    "hunt": [
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "caption", "text": "Scanner findings roam the streets as bugs", "sub": "catch them with a net, a bubble wand or a nail gun" },
      { "do": "catch", "tool": "net", "distance": 1.3, "read": 1.6 },
      { "do": "catch", "tool": "bubbles", "distance": 3.0, "read": 0.3 },
      { "do": "catch", "tool": "nailer", "distance": 4.0, "held": 0.8, "read": 0.3 }
    ],
    "fire": [
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "caption", "text": "Code that reaches a vulnerability catches fire", "sub": "put it out before it spreads to what imports it" },
      { "do": "douse", "s": 6, "back": 1.4 },
      { "do": "hold", "s": 1.2 }
    ],
    "photo": [
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "caption", "text": "Photograph what you find", "sub": "and look at it again on the camera" },
      { "do": "photo", "show": 3.2 },
      { "do": "hold", "s": 0.6 }
    ],
    "grapple": [
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "caption", "text": "Grapple from roof to roof", "sub": "the line bites, and pulls you across" },
      { "do": "grapple", "hops": 3, "near": 6, "far": 18, "rise": 3 },
      { "do": "caption", "text": "" },
      { "do": "hold", "s": 0.4 }
    ],
    "night": [
      { "do": "walk", "hide": ["header.toolbar", "#tooltip", "#status", "#walk-hud .w-keys", "#walk-hud .w-hint"] },
      { "do": "caption", "text": "Or strap on the jet backpack and fly the city at night" },
      { "do": "choose", "target": "#theme", "value": "dark" },
      { "do": "fly", "s": 9, "speed": 5, "turn": 0.35, "above": 3 },
      { "do": "caption", "text": "" },
      { "do": "hold", "s": 0.8 }
    ]
  }
}
