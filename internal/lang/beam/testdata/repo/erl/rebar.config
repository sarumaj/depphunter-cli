%% A rebar3 application.
{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.10.0"},
    {jsx, "~> 3.1"},
    erlware_commons,
    {hackney_fork, "1.20.1", {pkg, hackney}},
    {meck, {git, "https://github.com/eproxus/meck.git", {ref, "4ecc1ae9089edc6977e8c8c4cd41081513cc5590"}}},
    {recon, {git, "https://github.com/ferd/recon.git", {branch, "master"}}}
]}.

{profiles, [
    {test, [{deps, [{proper, "1.4.0"}]}]}
]}.
