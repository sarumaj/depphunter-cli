--  The shop's project file; with "commented.gpr"; is not read.
with "aunit";
with "gnatcoll";
with "xmlada";
with "libs/widgets/widgets.gpr";
limited with "config/shop_config.gpr";

project Shop is

   type Mode_Type is ("debug", "release");
   Mode : Mode_Type := external ("SHOP_MODE", "debug");

   for Source_Dirs use ("src", "src/" & Mode, "tools");
   for Object_Dir use "obj";
   for Main use ("shop-main.adb");

   case Mode is
      when "debug" =>
         for Main use ("shop-main.adb", "debug_tool");
      when others =>
         null;
   end case;

   package Naming is
      for Spec ("Legacy_IO") use "legacyio.ads";
      for Body ("Legacy_IO") use "legacyio.adb";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

end Shop;
