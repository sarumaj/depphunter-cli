{
    "name": "acme/app",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0",
        "guzzlehttp/guzzle": "7.8.1",
        "symfony/http-foundation": "^6.4",
        "acme/tools": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"},
        "psr-0": {"Legacy_": "lib/"},
        "classmap": ["database/"],
        "files": ["src/Support/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "repositories": [{"type": "path", "url": "packages/tools"}]
}
